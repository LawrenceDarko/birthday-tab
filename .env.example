# Supabase: Project Settings > API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenAI: platform.openai.com > API keys (needed only for receipt scanning)
OPENAI_API_KEY=sk-...
# Optional: vision model used for scanning
# OPENAI_MODEL=gpt-6-astra

# Optional but recommended: only people who know this can create bills or scan
CREATE_PASSCODE=pick-something

# Optional: the public address, for link previews (Vercel fills this in on its own)
# SITE_URL=https://giselle.example.com
